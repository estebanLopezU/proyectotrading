# Copia a .env y ajusta
SYMBOL=BTC/USDT
TIMEFRAME=1m
LIMIT=300
EXCHANGE_ID=binance
CACHE_PATH=data/btc_1m.csv
DISPLAY_TZ=America/Bogota
REFRESH_SECONDS=15

# === Opcion 3: Alertas Telegram ===
# 1) Habla con @BotFather en Telegram -> /newbot -> copia el token
# 2) Habla con @userinfobot -> copia tu chat_id
# 3) Pega ambos valores abajo (dejar vacio = alertas desactivadas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Probabilidad minima para disparar alerta (0.70 = 70%)
ALERT_MIN_PROBA=0.70
