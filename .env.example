# === Trading Prototype - Variables de entorno ===
# Copia este archivo como .env y completa los valores

# === Configuración del exchange ===
SYMBOL=BTC/USDT
TIMEFRAME=1m
LIMIT=300
EXCHANGE_ID=binance

# === Cache y datos ===
CACHE_PATH=data/btc_1m.csv
DISPLAY_TZ=America/Bogota
REFRESH_SECONDS=15

# === Telegram (opcional) ===
# Crea un bot con @BotFather y obten el token
# Para el chat_id, usa @userinfobot o la API de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_PROBA=0.80
